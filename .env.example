# Required for live image/scanned-PDF extraction. Use synthetic documents for the demo.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Enable only after approving external transmission of claim evidence.
GEMINI_EVIDENCE_REVIEW_ENABLED=false
# Deployment environment: production (default when unset), development, or test.
PLUM_ENV=
# Development/test only: fixed claim submission date/time (ISO date or datetime),
# e.g. 2024-11-05 to replay the supplied 2024-25 policy period. Requires
# PLUM_ENV=development or test; the app refuses to start if set in production.
# Every affected claim records the override in its decision trace and UI.
PLUM_DEMO_CLOCK=
